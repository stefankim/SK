# Copy to .env and set your Formspree endpoint to receive contact form messages.
# While unset, the form opens the visitor's email app with the message filled in.
VITE_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Analytics (cookieless, no consent banner needed). Set ONE provider; leave both empty for none.
# Plausible: add the site at plausible.io first, then put its domain here.
VITE_PLAUSIBLE_DOMAIN=
# Umami: the website ID from your Umami dashboard (set VITE_UMAMI_SRC if self-hosted).
VITE_UMAMI_WEBSITE_ID=
